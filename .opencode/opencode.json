{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepinfra/deepseek-ai/DeepSeek-V4-Flash",
  "formatter": {
    "prettier": {
      "disabled": true
    },
    "lint-formatter": {
      "command": ["npx", "eslint", "--fix", "$FILE"],
      "extensions": [".js", ".mjs", ".ts", ".jsx", ".tsx"]
    }
  },
  "lsp": true,
  "permission": {
    "external_directory": {
      "/tmp/**": "allow",
      "*": "ask"
    }
  },
}
