{
  "name": "@lizzythelizard/whatsapp-mcp",
  "version": "0.4.0",
  "description": "MCP server for WhatsApp integration",
  "author": {
    "name": "Matthias Graf"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lizzyTheLizard/whatsapp-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/lizzyTheLizard/whatsapp-mcp/issues"
  },
  "homepage": "https://github.com/lizzyTheLizard/whatsapp-mcp#readme",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "whatsapp-mcp": "dist/main.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "inspect": "npx @modelcontextprotocol/inspector npm run --silent start",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "mcpb:manifest": "node scripts/create-mcpb-manifest.mjs",
    "mcpb:pack": "npx mcpb pack",
    "mcpb": "npm run mcpb:manifest && npm run mcpb:pack"
  },
  "keywords": [
    "mcp",
    "whatsapp",
    "model-context-protocol"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@whiskeysockets/baileys": "^7.0.0-rc13",
    "qrcode": "^1.5.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/inspector": "^0.22.0",
    "@types/node": "^26.0.1",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "eslint": "^10.5.0",
    "eslint-plugin-import-x": "^4.17.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9"
  }
}
